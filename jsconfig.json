{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "strict": true
  },
  "exclude": ["node_modules"],
  "typeAcquisition": {
    "enable": true
  }
}
